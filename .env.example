# ============================================================================
# Khel Arena — backend configuration
#
# Copy to .env and fill in. Every value is read once at startup and validated
# eagerly: a misconfigured service fails to boot with a clear message rather
# than failing on the first request that happens to need the missing setting.
# ============================================================================

APP_ENV=development
HTTP_ADDR=:8080

# The interface's own origin. Payers return here after a gateway, and reset
# links in email point at it. Configuration rather than anything read off a
# request: deriving it from a Host header would let a caller choose the domain
# in an email we send.
APP_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
# Stock PostgreSQL 14 or newer. Requires the pgcrypto, btree_gist and citext
# extensions, which the first migration creates.
DATABASE_URL=postgres://khel:khel@localhost:5432/khel_arena?sslmode=disable

# Connection pool. Leave unset to accept pgx's defaults.
DB_MAX_CONNS=16
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

# ── Authentication ──────────────────────────────────────────────────────────
# At least 32 bytes. Generate with:  openssl rand -base64 48
# Changing it invalidates every access token in circulation.
JWT_SECRET=

JWT_ISSUER=khel-arena
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ── Booking ─────────────────────────────────────────────────────────────────
# How long an unpaid hold blocks its slot before the janitor releases it.
BOOKING_HOLD_WINDOW=15m

# The wall-clock zone arenas publish their opening hours in.
ARENA_TIMEZONE=Asia/Kathmandu

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the API accepts browser requests from.
# Leave empty when the interface is served from the same origin, which is what
# the production compose file does -- then no cross-origin grant is needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Proxies ─────────────────────────────────────────────────────────────────
# How many reverse proxies sit between a client and this service.
#
# 0 (the default) ignores X-Forwarded-For entirely and takes the address from
# the connection. Correct when nothing is in front, and wrong the moment
# something is: every request then carries the proxy's address, so the login
# rate limiter has one bucket for every client at once and a single attacker
# locks out everybody.
#
# 1 is the production compose file: Caddy, and nothing else. Add one per extra
# hop -- a CDN in front of Caddy makes it 2. Count it exactly: too high lets a
# caller prepend its own address and mint a fresh rate-limit bucket per
# attempt, which is worse than no limit because it reads as one.
#
# Every proxy in the chain must *append* to X-Forwarded-For rather than
# replace it. Caddy's reverse_proxy and nginx's $proxy_add_x_forwarded_for
# both do.
TRUSTED_PROXY_HOPS=0


# ── Email ───────────────────────────────────────────────────────────────────
# Transactional mail: currently only the password-reset link, which is the one
# route back into a locked-out account.
#
# With SMTP_HOST unset, messages are written to the log instead of sent, which
# makes the reset flow completable locally. Production refuses to start without
# these -- a deployment that logs the link has no recovery path at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Khel Arena

# ── Payments ────────────────────────────────────────────────────────────────
# Gateway credentials (eSewa / Khalti keys) are now per venue: each arena
# owner stores their own on the venue's management page, and the money settles
# into their account, not the platform's. The only deployment-wide setting is
# the key those stored secrets are encrypted with at rest.
#
# Unset: venues cannot configure online payments and every booking is settled
# in cash. Set: 32 random bytes, base64. Rotating it makes every stored
# credential unreadable, so treat it like JWT_SECRET.
#   openssl rand -base64 32
PAYMENT_ENC_KEY=

# ── Uploads ─────────────────────────────────────────────────────────────────
# Where uploaded images are kept, and the URL path they are served under.
# Unset turns uploads off; galleries still accept a URL you host elsewhere.
#
# A directory works on one machine or a shared volume. Behind more than one
# instance this wants object storage -- see internal/platform/media.
MEDIA_DIR=./.media
MEDIA_URL_PREFIX=/media

# ── Deployment (compose.yaml only) ──────────────────────────────────────────
# Read by compose.yaml, not by the Go service. Ignore them for local
# development, where `make run` and `make web` are the whole story.

# The hostname Caddy serves and requests a certificate for. A bare hostname
# (khelarena.com.np) gets HTTPS automatically. `http://localhost` runs the
# stack with no certificate, which is useful for checking the topology and
# useless for serving anyone: APP_ENV=production marks the refresh cookie
# Secure, so over plain http no one stays signed in.
SITE_ADDRESS=khelarena.com.np

# Postgres runs in the stack, so these create the database rather than
# describe an existing one. DATABASE_URL above must agree with them, and its
# host must be `db` -- the service name on the compose network.
#   DATABASE_URL=postgres://khel:<POSTGRES_PASSWORD>@db:5432/khel_arena?sslmode=disable
# sslmode=disable is right for that hop and only that hop: it never leaves the
# container network. Point this at a managed database instead and it becomes
# sslmode=require.
POSTGRES_USER=khel
POSTGRES_PASSWORD=
POSTGRES_DB=khel_arena

# ── Tests ───────────────────────────────────────────────────────────────────
# Integration tests run against a real database and skip when this is unset.
# Point it at a disposable database — the suite migrates and writes to it.
TEST_DATABASE_URL=postgres://khel:khel@localhost:5432/khel_arena_test?sslmode=disable
